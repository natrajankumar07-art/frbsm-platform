# ============================================================
# BSM Platform — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ============================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bsm:bsm@localhost:5433/bsm
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_MODE=local            # production | staging | demo | local
DEBUG=false
SECRET_KEY=change-me-in-production-use-32-random-bytes
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication (OIDC)
# ---------------------------------------------------------------------------
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=bsm-api
OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# Pinned model — do not change without running the full eval suite.

# ---------------------------------------------------------------------------
# Demo mode (only used when APP_MODE=demo)
# ---------------------------------------------------------------------------
DEMO_ANTHROPIC_API_KEY=sk-ant-demo-...
DEMO_MONTHLY_LLM_BUDGET_USD=50.00

# ---------------------------------------------------------------------------
# Object storage (snapshots)
# ---------------------------------------------------------------------------
SNAPSHOT_STORAGE_BACKEND=local     # local | s3
SNAPSHOT_LOCAL_PATH=./data/snapshots
AWS_REGION=ap-south-1
S3_SNAPSHOT_BUCKET=bsm-snapshots-prod

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bsm-api
LOG_LEVEL=INFO
